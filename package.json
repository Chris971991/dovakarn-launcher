{
  "name": "dovakarn-launcher",
  "version": "3.1.0",
  "description": "Launcher for the Dovakarn server",
  "productName": "Dovakarn Launcher",
  "main": "src/main.js",
  "author": "Chris Carruthers (fork of F02K/SkyMP-Launcher by Tecca)",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "test": "node --test"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "adm-zip": "^0.5.10",
    "electron": "41.2.0",
    "electron-builder": "26.8.1",
    "jsdom": "^30.1.2"
  },
  "build": {
    "appId": "com.skyrp.launcher",
    "productName": "Dovakarn Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "!assets/7zip/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/7zip",
        "to": "7zip"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "DovakarnLauncher-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "artifactName": "DovakarnLauncher.exe",
      "include": "installer.nsh"
    },
    "electronFuses": {
      "enableCookieEncryption": true
    }
  }
}
