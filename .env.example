# Backend API
# Base URL of the Dovakarn backend (skymp5-backend): Discord login, Play, the server list and the player file list.
# For development only: a packaged installer reads no .env, so for a release set apiUrl in src/config.js before
# building. Local testing (--combat-test) needs none of this.
API_URL=http://127.0.0.1:4000
